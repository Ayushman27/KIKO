# JARVIS Personal Agent Environment Variables

# Backend Server
PORT=8000
HOST=0.0.0.0
SECRET_KEY=jarvis_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supports sqlite for zero-config dev, or postgresql)
DATABASE_URL=sqlite:///./jarvis.db
# DATABASE_URL=postgresql://jarvis:jarvispass@localhost:5432/jarvis_db

# AI Provider Configuration
# Supported providers: openai, ollama, local, rule
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=local-model

# Windows Agent Configuration
WINDOWS_AGENT_BACKEND_URL=http://localhost:8000
WINDOWS_AGENT_WS_URL=ws://localhost:8000/ws/agent
DEVICE_NAME=Ayushman's Windows Laptop
DEVICE_AUTH_TOKEN=dev_device_token_secret_12345

# Email & Communication Credentials (Optional)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
OUTLOOK_USER=your_email@outlook.com
OUTLOOK_PASSWORD=your_password
